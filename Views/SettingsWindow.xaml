<ui:FluentWindow x:Class="ImageViewer.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置" Width="560" Height="480" WindowStartupLocation="CenterOwner"
                 Background="#FF1E1E1E" ResizeMode="NoResize" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ui:TextBlock FontSize="16" FontWeight="Bold" Text="文件关联" />
        <ui:TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#CCFFFFFF"
                      Text="把 ImageViewer 注册为 jpg/png/bmp 的打开候选。机器级注册需要管理员授权（弹出 UAC）；Windows 不允许程序自动设为默认，请在随后打开的系统设置中手动确认。" />
        <ui:Card Margin="0,12,0,0" Padding="16">
          <StackPanel>
            <ui:TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#FFE0A030" />
            <WrapPanel Margin="0,12,0,0">
              <ui:Button Content="注册为打开候选" Appearance="Primary" Margin="0,0,8,8" Click="RegisterClick" />
              <ui:Button Content="取消关联" Margin="0,0,8,8" Click="UnregisterClick" />
              <ui:Button Content="默认应用设置" Margin="0,0,0,8" Click="OpenDefaultAppsClick" />
            </WrapPanel>
          </StackPanel>
        </ui:Card>

        <ui:TextBlock Margin="0,24,0,0" FontSize="16" FontWeight="Bold" Text="日志" />
        <ui:TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#CCFFFFFF"
                      Text="选择写入日志的最低级别，立即生效并保存到 exe 同目录的 ImageViewer.exe.config。日志文件位于 %AppData%\ImageViewer\Logs\。" />
        <ui:Card Margin="0,12,0,0" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" VerticalAlignment="Center" Text="最低日志级别" />
            <ComboBox x:Name="LogLevelComboBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                      SelectionChanged="LogLevelSelectionChanged" />
          </Grid>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>

    <ui:Button Grid.Row="1" Content="关闭" Margin="0,16,0,0" HorizontalAlignment="Right" Click="CloseClick" />
  </Grid>
</ui:FluentWindow>
