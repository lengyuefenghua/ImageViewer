<ui:FluentWindow x:Class="ImageViewer.Viewer.ViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Icon="/ImageViewer.ico" Width="1100" Height="800" WindowStartupLocation="CenterScreen" Background="{DynamicResource ApplicationBackgroundBrush}"                  Focusable="True" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" SourceInitialized="OnSourceInitialized" Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed" PreviewKeyDown="OnPreviewKeyDown">
  <DockPanel>
    <ui:TitleBar x:Name="ViewerTitleBar" DockPanel.Dock="Top" Background="{DynamicResource LayerFillColorDefaultBrush}" Height="30" FontSize="15" Padding="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}">
      <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False" Margin="16,0,0,0">
          <Image x:Name="AppIcon" Height="24" Margin="0,0,8,0" />
          <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" VerticalAlignment="Center" FontSize="15" />
        </StackPanel>
      </ui:TitleBar.Header>
    </ui:TitleBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- 右侧缩略图列：纯内存加载，默认显示，T 键或右键菜单折叠。 -->
      <Border x:Name="ThumbnailPane" Grid.Row="0" Grid.Column="1" Width="140" Margin="8,0,0,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
        <ListBox x:Name="ThumbnailListBox" Background="Transparent" BorderThickness="0" Padding="6,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="ThumbnailSelectionChanged" PreviewMouseWheel="ThumbnailListMouseWheel">
          <ListBox.Resources>
            <!-- 覆写 WPF UI 的选中背景键（模板内部触发器引用它），比默认亮蓝更低调。 -->
            <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
          </ListBox.Resources>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Width="120" Height="90">
                <Image Source="{Binding Bitmap}" Stretch="Uniform" />
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="无法预览" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Grid Grid.Row="0" Grid.Column="0" x:Name="ViewportHost" ClipToBounds="True" SizeChanged="ViewportHost_SizeChanged" MouseWheel="ViewportHost_MouseWheel" MouseLeftButtonDown="ViewportHost_MouseLeftButtonDown" MouseMove="ViewportHost_MouseMove" MouseLeftButtonUp="ViewportHost_MouseLeftButtonUp" MouseLeave="ViewportHost_MouseLeave">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="打开图片..." Click="OpenImageClick" />
            <Separator />
            <MenuItem Header="适应窗口" Click="FitClick" />
            <MenuItem Header="100%" Click="ActualSizeClick" />
            <Separator />
            <MenuItem Header="复制图片" InputGestureText="Ctrl+C" Click="CopyFileClick" />
            <MenuItem Header="复制图片路径" Click="CopyPathClick" />
            <MenuItem Header="复制到..." Click="CopyToClick" />
            <MenuItem Header="在资源管理器中显示" Click="RevealInExplorerClick" />
            <Separator />
            <MenuItem Header="缩略图列表" Click="ToggleThumbnailsClick" />
            <Separator />
            <MenuItem x:Name="FullScreenMenuItem" Header="全屏" Click="FullScreenClick" />
            <Separator />
            <MenuItem Header="设置..." Click="OpenSettingsClick" />
            <Separator />
            <MenuItem Header="退出" Click="ExitClick" />
          </ContextMenu>
        </Grid.ContextMenu>
        <!-- 深色棋盘格垫底：透明/浅色图片也能看清边界。 -->
        <Grid.Background>
          <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
              <DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource ApplicationBackgroundBrush}" Geometry="M0,0 H16 V16 H0 Z" />
                <GeometryDrawing Brush="{DynamicResource ControlFillColorSecondaryBrush}" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
              </DrawingGroup>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Grid.Background>
        <Canvas>
          <Image x:Name="ImageSurface" Source="{Binding DisplayBitmap}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Canvas>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" CornerRadius="4" Padding="12,6" Background="#80000000">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="加载中…" Foreground="White" />
        </Border>
        <!-- 同级目录切换 / 多图打开的短暂提示。 -->
        <Border x:Name="FolderSwitchToast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                IsHitTestVisible="False" CornerRadius="6" Padding="14,8" Visibility="Collapsed"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
          <TextBlock x:Name="FolderSwitchText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" />
        </Border>
      </Grid>
      <Border Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Background="#B3000000" Padding="12,6" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal">
          <TextBlock Foreground="White" Text="{Binding ImageDimensionsWithDepth}" Margin="0,0,12,0" />
          <TextBlock Foreground="#66FFFFFF" Text="│" Margin="0,0,12,0" />
          <TextBlock Foreground="White" Margin="0,0,12,0">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0}/{1}">
                <Binding Path="CurrentPosition" />
                <Binding Path="ResultCount" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Foreground="#66FFFFFF" Text="│" Margin="0,0,12,0" />
          <TextBlock Foreground="White" Text="{Binding ZoomPercent, StringFormat={}{0}%}" Margin="0,0,12,0" />
          <TextBlock Foreground="#66FFFFFF" Text="│" Margin="0,0,12,0" />
          <TextBlock Foreground="White" Margin="0,0,12,0">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} / {1}">
                <Binding Path="ImageSizeDisplay" />
                <Binding Path="ImageDecodedSizeDisplay" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Foreground="#66FFFFFF" Text="│" Margin="0,0,12,0" />
          <TextBlock Foreground="White" Text="{Binding ImageModifiedDisplay}" Margin="0,0,12,0" />
          <TextBlock Foreground="#66FFFFFF" Text="│" Margin="0,0,12,0" />
          <TextBlock Foreground="White" Text="{Binding PointerX, StringFormat=X {0}}" Margin="0,0,10,0" />
          <TextBlock Foreground="White" Text="{Binding PointerY, StringFormat=Y {0}}" Margin="0,0,14,0" />
          <TextBlock Foreground="White" Text="{Binding PixelR, StringFormat=R {0}}" Margin="0,0,10,0" />
          <TextBlock Foreground="White" Text="{Binding PixelG, StringFormat=G {0}}" Margin="0,0,10,0" />
          <TextBlock Foreground="White" Text="{Binding PixelB, StringFormat=B {0}}" />
        </StackPanel>
      </Border>
      <Border Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,10" CornerRadius="4" Background="#CC7A1F1F">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap" MaxWidth="600" />
      </Border>
    </Grid>
  </DockPanel>
</ui:FluentWindow>
